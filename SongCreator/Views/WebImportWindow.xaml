<Window x:Class="SongCreator.Views.WebImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Import from the web" Width="1150" Height="820" MinWidth="700" MinHeight="500"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextForeground}"
        FontFamily="{DynamicResource UiFont}">
    <DockPanel>
        <!-- Search, navigation and address -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackground}" Padding="8,6"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets">
                    <Button Content="&#xE72B;" Style="{StaticResource FlatButton}" ToolTip="Back"
                            AutomationProperties.Name="Back" Click="Back_Click" />
                    <Button Content="&#xE72A;" Style="{StaticResource FlatButton}" ToolTip="Forward"
                            AutomationProperties.Name="Forward" Click="Forward_Click" />
                    <Button Content="&#xE72C;" Style="{StaticResource FlatButton}" ToolTip="Reload"
                            AutomationProperties.Name="Reload" Click="Reload_Click" />
                </StackPanel>
                <Border DockPanel.Dock="Left" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource KeyCapBorder}"
                        BorderThickness="1" CornerRadius="4" Padding="6,3" Width="300" Margin="8,0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource HintTextBox}" Tag="Search a song, e.g. Amazing Grace"
                             AutomationProperties.Name="Search"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown" />
                </Border>
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource KeyCapBorder}"
                        BorderThickness="1" CornerRadius="4" Padding="6,3">
                    <TextBox x:Name="AddressBox" Style="{StaticResource HintTextBox}" Tag="Address"
                             AutomationProperties.Name="Address" KeyDown="AddressBox_KeyDown" />
                </Border>
            </DockPanel>
        </Border>

        <!-- Import -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ToolbarBackground}" Padding="16,10"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Cancel" Style="{StaticResource FlatButton}" Padding="14,8" IsCancel="True" />
                    <Button Content="Import" Style="{StaticResource PrimaryButton}" Padding="22,8" Margin="8,0,0,0"
                            ToolTip="Import the selected text, or the page's chord sheet if nothing is selected"
                            Click="Import_Click" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,2">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" FontSize="12"
                               Text="Open a song's chord page, select its chords and lyrics (or select nothing to take the page's chord sheet), then press Import. Songs on chord sites are usually copyrighted: import them for your own use, and check the site's terms before sharing." />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <wv2:WebView2 x:Name="Browser" />
            <TextBlock x:Name="BrowserError" Visibility="Collapsed" TextWrapping="Wrap" Margin="40" MaxWidth="560"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"
                       Text="The built-in browser needs the Microsoft Edge WebView2 Runtime, which isn't installed. Get it from https://go.microsoft.com/fwlink/p/?LinkId=2124703, then open this window again." />
        </Grid>
    </DockPanel>
</Window>
