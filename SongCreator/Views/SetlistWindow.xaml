<Window x:Class="SongCreator.Views.SetlistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setlist" Width="700" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextForeground}"
        Closing="Window_Closing">
    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1"
            CornerRadius="12" Margin="40" Effect="{DynamicResource CardShadow}">
        <DockPanel>
            <!-- Header (drag to move): the setlist's name, open and save -->
            <DockPanel DockPanel.Dock="Top" Margin="28,24,28,16" Background="Transparent"
                       MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Open…" Style="{StaticResource FlatButton}" Command="{Binding OpenCommand}" />
                    <Button Content="Save" Style="{StaticResource FlatButton}" Command="{Binding SaveCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HintTextBox}"
                             Tag="Setlist name" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}"
                               Text="Songs in playing order, each in the key you'll play it in. The song files stay as they are." />
                </StackPanel>
            </DockPanel>

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="28,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Style="{StaticResource FlatButton}" Padding="14,8" IsCancel="True" />
                    <Button Content="Export PDF" Style="{StaticResource PrimaryButton}" Padding="22,8" Margin="8,0,0,0"
                            Command="{Binding ExportCommand}"
                            IsEnabled="{Binding IsEmpty, Converter={StaticResource InverseBoolean}}" />
                </StackPanel>
            </Border>

            <!-- Export options -->
            <WrapPanel DockPanel.Dock="Bottom" Margin="28,4,28,12">
                <CheckBox Content="Table of contents" IsChecked="{Binding IncludeTableOfContents}" Margin="0,0,28,6" />
                <CheckBox Content="Chords as Roman numerals" IsChecked="{Binding RomanNumerals}" Margin="0,0,28,6" />
                <CheckBox Content="Open the PDF when done" IsChecked="{Binding OpenWhenDone}" Margin="0,0,0,6" />
            </WrapPanel>

            <!-- Song list -->
            <StackPanel Margin="20,0,20,8">
                <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="4">
                    <Grid>
                        <TextBlock Text="No songs yet. Add song files to build the setlist." Margin="12,18"
                                   Foreground="{DynamicResource MutedForeground}" HorizontalAlignment="Center"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />
                        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="6" Padding="10,6" Background="Transparent">
                                            <DockPanel>
                                                <!-- Position in the set -->
                                                <TextBlock DockPanel.Dock="Left" Width="26" VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource SongFont}" Foreground="{DynamicResource MutedForeground}"
                                                           Text="{Binding Position}" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                            TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets">
                                                    <Button Content="&#xE70E;" Style="{StaticResource FlatButton}" Padding="7,5" FontSize="11"
                                                            ToolTip="Move up" Foreground="{DynamicResource MutedForeground}"
                                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="&#xE70D;" Style="{StaticResource FlatButton}" Padding="7,5" FontSize="11"
                                                            ToolTip="Move down" Foreground="{DynamicResource MutedForeground}"
                                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="&#xE711;" Style="{StaticResource FlatButton}" Padding="7,5" FontSize="11"
                                                            ToolTip="Remove from setlist" Foreground="{DynamicResource MutedForeground}"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <!-- Key to play it in -->
                                                <StackPanel DockPanel.Dock="Right" Width="150" Margin="12,0" VerticalAlignment="Center">
                                                    <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding KeyOptions}"
                                                              SelectedItem="{Binding Key}" FontWeight="SemiBold" MinHeight="26"
                                                              HorizontalAlignment="Left" MinWidth="70" ToolTip="Key to play it in"
                                                              Visibility="{Binding HasKey, Converter={StaticResource BoolToVisible}}" />
                                                    <TextBlock Text="{Binding KeyNote}" FontSize="11" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource MutedForeground}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Song.DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FileName}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource MutedForeground}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ButtonHover}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
                <Button Content="+ Add songs…" Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                        Margin="0,8,0,0" Padding="10,6" Command="{Binding AddSongsCommand}" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
