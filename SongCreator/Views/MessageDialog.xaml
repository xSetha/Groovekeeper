<Window x:Class="SongCreator.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- A message the user must read before going on, e.g. a song that couldn't be saved -->
    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1"
            CornerRadius="4" Padding="28,24" Margin="40" Width="420" Effect="{DynamicResource CardShadow}">
        <StackPanel>
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextForeground}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="Detail" Margin="0,10,0,24" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" />
            <Button x:Name="OkButton" Content="OK" Style="{StaticResource PrimaryButton}" Padding="22,8"
                    HorizontalAlignment="Right" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </Border>
</Window>
