<Window x:Class="SongCreator.Views.LibraryPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add songs from the library" Width="480" Height="600" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource TextForeground}">
    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1"
            CornerRadius="12" Margin="40" Effect="{DynamicResource CardShadow}">
        <DockPanel>
            <!-- Header (drag to move) -->
            <StackPanel DockPanel.Dock="Top" Margin="28,24,28,12" Background="Transparent"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Add songs from the library" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}"
                           Text="Ctrl+click or Shift+click to pick several songs." />
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource KeyCapBorder}" BorderThickness="1"
                        CornerRadius="4" Padding="6,4">
                    <TextBox x:Name="SearchBox" Style="{StaticResource HintTextBox}" Tag="Search title, artist or key"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="28,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource FlatButton}" Padding="14,8" IsCancel="True" />
                    <Button Content="Add" Style="{StaticResource PrimaryButton}" Padding="22,8" Margin="8,0,0,0"
                            IsDefault="True" Click="Add_Click" />
                </StackPanel>
            </Border>

            <Grid Margin="20,0,20,8">
                <TextBlock Text="The library has no songs yet. Import songs or save a new song first." TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedForeground}" Margin="8"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />
                <ListBox x:Name="SongList" ItemsSource="{Binding Songs}" ItemTemplate="{StaticResource LibrarySong}"
                         ItemContainerStyle="{StaticResource LibrarySongItem}" SelectionMode="Extended"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="SongList_MouseDoubleClick" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
