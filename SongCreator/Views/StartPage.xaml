<UserControl x:Class="SongCreator.Views.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackground}"
             Foreground="{DynamicResource TextForeground}">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource KeyCapBorder}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="TextElement.FontFamily" Value="{DynamicResource SongFont}" />
            <Setter Property="TextElement.FontSize" Value="12" />
        </Style>
        <Style x:Key="TipNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource SongFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="TipTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="TipText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedForeground}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
        <!-- Chord tag inside a monospace TextBlock -->
        <Style x:Key="Chord" TargetType="Run">
            <Setter Property="Background" Value="{DynamicResource ChordTagBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ChordTagForeground}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- Theme choice; BorderBrush marks the active theme (set from code) -->
        <Style x:Key="ThemePill" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardBackground}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5" CornerRadius="18" Padding="12,7,16,7">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1000" Margin="56,64,56,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Hero -->
            <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,40,0">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                           Text="CHORDS  ·  LYRICS  ·  STRUCTURE" Margin="0,0,0,14" />
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/SongCreator.png" Width="52" Height="52" Margin="0,4,16,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock FontSize="48" FontWeight="Bold" Text="SongCreator" />
                </StackPanel>
                <TextBlock FontSize="19" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap"
                           Margin="0,12,0,32" LineHeight="28" MaxWidth="420" HorizontalAlignment="Left"
                           Text="Write your lyrics, then drop each chord exactly on the syllable where it changes." />

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewSongCommand}" FontSize="15">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="New song" />
                            <TextBlock Text="Ctrl+N" Margin="12,0,0,0" Opacity="0.6" FontWeight="Normal" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Command="{Binding OpenSongCommand}" FontSize="15"
                            Padding="16,10" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Open song…" />
                            <TextBlock Text="Ctrl+O" Margin="12,0,0,0" Foreground="{DynamicResource MutedForeground}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Chord sheet preview -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="28,24" Width="360"
                    VerticalAlignment="Center" Effect="{DynamicResource CardShadow}">
                <StackPanel TextElement.FontFamily="{DynamicResource SongFont}" TextElement.FontSize="14">
                    <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="16" FontWeight="SemiBold" Text="Twinkle, Twinkle" />
                    <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="12" Foreground="{DynamicResource MutedForeground}" Margin="0,2,0,14">
                        <Run Text="Tuning:" /> <Run Text="E A D G B E" Foreground="{DynamicResource TextForeground}" /> <Run Text="·  Key:" /> <Run Text="C" Foreground="{DynamicResource TextForeground}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Text="[Verse 1]" Margin="0,0,0,2" />
                    <TextBlock><Run Style="{StaticResource Chord}" Text="C" /><Run Text="                 " /><Run Style="{StaticResource Chord}" Text="F" /><Run Text="      " /><Run Style="{StaticResource Chord}" Text="C" /></TextBlock>
                    <TextBlock Text="Twinkle, twinkle, little star" Margin="0,0,0,4" />
                    <TextBlock><Run Style="{StaticResource Chord}" Text="F" /><Run Text="     " /><Run Style="{StaticResource Chord}" Text="C" /><Run Text="      " /><Run Style="{StaticResource Chord}" Text="G" /><Run Text="        " /><Run Style="{StaticResource Chord}" Text="C" /></TextBlock>
                    <TextBlock Text="How I wonder what you are" />
                </StackPanel>
            </Border>

            <!-- How it works -->
            <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="3" Margin="-8,64,-8,0">
                <Border Style="{StaticResource Card}" Padding="20" Margin="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TipNumber}" Text="01" />
                        <TextBlock Style="{StaticResource TipTitle}" Text="Paste your lyrics" />
                        <TextBlock Style="{StaticResource TipText}"
                                   Text="Paste a whole song at once. Each line becomes a lyric line, and a row like [Chorus] starts a new section." />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="20" Margin="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TipNumber}" Text="02" />
                        <TextBlock Style="{StaticResource TipTitle}" Text="Click above a letter" />
                        <TextBlock Style="{StaticResource TipText}"
                                   Text="Type the chord name and press Enter. It stays anchored to that letter while you keep editing the words." />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="20" Margin="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TipNumber}" Text="03" />
                        <TextBlock Style="{StaticResource TipTitle}" Text="Refine and transpose" />
                        <TextBlock Style="{StaticResource TipText}"
                                   Text="Drag chords to move them, click to rename, right-click to remove. Transpose the whole song from the Song menu." />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Shortcuts -->
            <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,28,0,0" TextElement.Foreground="{DynamicResource MutedForeground}">
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Enter" /></Border>
                <TextBlock Text="split line" Margin="0,0,24,8" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Backspace" /></Border>
                <TextBlock Text="join with line above" Margin="0,0,24,8" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="↑" /></Border>
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="↓" /></Border>
                <TextBlock Text="move between lines" Margin="0,0,24,8" />
                <Border Style="{StaticResource KeyCap}"><TextBlock Text="Esc" /></Border>
                <TextBlock Text="cancel chord edit" Margin="0,0,0,8" />
            </WrapPanel>

            <!-- Theme picker -->
            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,28,0,0">
                <TextBlock Text="THEME" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{DynamicResource MutedForeground}" />
                <ItemsControl ItemsSource="{Binding Themes.Options}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding SelectCommand}" ToolTip="{Binding Description}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ThemePill}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="12" Height="12" Margin="0,0,8,0" Fill="{Binding Accent}" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
