<Window x:Class="SongCreator.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFont}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!-- A yes/no question in the app's theme, e.g. before deleting something -->
    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1"
            CornerRadius="10" Padding="28,24" Margin="40" Width="420" Effect="{DynamicResource CardShadow}">
        <StackPanel>
            <TextBlock x:Name="Question" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextForeground}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="Detail" Margin="0,10,0,24" Foreground="{DynamicResource MutedForeground}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Cancel has the focus, so Enter or Esc never confirms by accident -->
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource FlatButton}" Padding="12,8" IsCancel="True" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Padding="22,8" Margin="8,0,0,0"
                        Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
