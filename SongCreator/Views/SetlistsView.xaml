<UserControl x:Class="SongCreator.Views.SetlistsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Setlists tab (SetlistViewModel): the setlists, the selected one's songs, and the library to add from.
         Every change is saved right away. Songs are dragged to reorder them, or in from the library. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- Setlists -->
        <Border Grid.Column="0" Background="{DynamicResource ToolbarBackground}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,1,0" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="SETLISTS" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{DynamicResource MutedForeground}" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="+ New setlist" Style="{StaticResource FlatButton}" Padding="10,6" Command="{Binding NewCommand}" />
                    <Button Content="Import…" Style="{StaticResource FlatButton}" Padding="10,6" Margin="4,0,0,0"
                            Command="{Binding ImportCommand}" ToolTip="Import a .setlist file and its songs into the library" />
                </StackPanel>
                <Grid>
                    <TextBlock Text="No setlists yet." Foreground="{DynamicResource MutedForeground}" Margin="4,8"
                               Visibility="{Binding HasSetlists, Converter={StaticResource BoolToCollapsed}}" />
                    <ListBox ItemsSource="{Binding Setlists}" SelectedItem="{Binding SelectedSetlist}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource LibrarySongItem}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="2,5" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- The selected setlist -->
        <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Foreground="{DynamicResource MutedForeground}" LineHeight="22"
                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToCollapsed}}"
                   Text="Pick a setlist on the left, or create one with + New setlist.&#10;A setlist puts library songs in playing order, each in the key you'll play it in." />
        <DockPanel Grid.Column="1" Margin="32,24,32,20" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
            <!-- Name, and delete -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="Delete setlist" Style="{StaticResource FlatButton}" VerticalAlignment="Top"
                        Command="{Binding DeleteCommand}" ToolTip="Delete this setlist (its songs stay in the library)" />
                <StackPanel>
                    <!-- Saved when the box loses focus or on Enter, so the list isn't re-sorted while typing -->
                    <TextBox x:Name="NameBox" Text="{Binding Name}" Style="{StaticResource HintTextBox}" Tag="Setlist name"
                             FontSize="22" FontWeight="SemiBold" KeyDown="NameBox_KeyDown" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}"
                               Text="Drag songs to reorder them. Double-click a song to edit it; the change shows in every setlist that has it." />
                </StackPanel>
            </DockPanel>

            <!-- Export -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Content="Export PDF" Style="{StaticResource PrimaryButton}" Padding="22,8"
                        VerticalAlignment="Center" Command="{Binding ExportCommand}"
                        IsEnabled="{Binding IsEmpty, Converter={StaticResource InverseBoolean}}" />
                <WrapPanel VerticalAlignment="Center">
                    <CheckBox Content="Table of contents" IsChecked="{Binding IncludeTableOfContents}" Margin="0,4,24,4" />
                    <CheckBox Content="Chords as Roman numerals" IsChecked="{Binding RomanNumerals}" Margin="0,4,24,4" />
                    <CheckBox Content="Open the PDF when done" IsChecked="{Binding OpenWhenDone}" Margin="0,4,24,4" />
                </WrapPanel>
            </DockPanel>

            <!-- Songs, in playing order; a drop target for reordering and for library songs -->
            <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="4"
                    Background="Transparent" AllowDrop="True" DragOver="SongList_DragOver" Drop="SongList_Drop">
                <Grid>
                    <TextBlock Text="No songs yet. Drag songs here from the library, or press + next to one." Margin="12,18"
                               Foreground="{DynamicResource MutedForeground}" HorizontalAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />
                    <ScrollViewer x:Name="SongScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SongList" ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="6" Padding="6,6,10,6" Background="Transparent" Cursor="SizeAll"
                                            ToolTip="Drag to reorder, double-click to edit the song"
                                            PreviewMouseLeftButtonDown="SongRow_PreviewMouseLeftButtonDown"
                                            MouseMove="SongRow_MouseMove" MouseLeftButtonDown="SongRow_MouseLeftButtonDown">
                                        <DockPanel>
                                            <!-- Drag handle and position in the set -->
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE76F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource MutedForeground}" />
                                            <TextBlock DockPanel.Dock="Left" Width="26" VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource SongFont}" Foreground="{DynamicResource MutedForeground}"
                                                       Text="{Binding Position}" />
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Arrow"
                                                        TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets">
                                                <Button Content="&#xE70F;" Style="{StaticResource FlatButton}" Padding="7,5" FontSize="11"
                                                        ToolTip="Edit the song" AutomationProperties.Name="Edit the song"
                                                        Foreground="{DynamicResource MutedForeground}"
                                                        Command="{Binding DataContext.OpenSongCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="&#xE70E;" Style="{StaticResource FlatButton}" Padding="7,5" FontSize="11"
                                                        ToolTip="Move up" AutomationProperties.Name="Move up"
                                                        Foreground="{DynamicResource MutedForeground}"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="&#xE70D;" Style="{StaticResource FlatButton}" Padding="7,5" FontSize="11"
                                                        ToolTip="Move down" AutomationProperties.Name="Move down"
                                                        Foreground="{DynamicResource MutedForeground}"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="&#xE711;" Style="{StaticResource FlatButton}" Padding="7,5" FontSize="11"
                                                        ToolTip="Remove from setlist" AutomationProperties.Name="Remove from setlist"
                                                        Foreground="{DynamicResource MutedForeground}"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <!-- Key to play it in -->
                                            <StackPanel DockPanel.Dock="Right" Width="150" Margin="12,0" VerticalAlignment="Center" Cursor="Arrow">
                                                <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding KeyOptions}"
                                                          SelectedItem="{Binding Key}" FontWeight="SemiBold" MinHeight="26"
                                                          HorizontalAlignment="Left" MinWidth="70" ToolTip="Key to play it in"
                                                          Visibility="{Binding HasKey, Converter={StaticResource BoolToVisible}}" />
                                                <TextBlock Text="{Binding KeyNote}" FontSize="11" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource MutedForeground}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Song.DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Song.Artist}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource MutedForeground}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ButtonHover}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </DockPanel>

        <!-- The library, to add songs from -->
        <Border Grid.Column="2" Background="{DynamicResource ToolbarBackground}" BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1,0,0,0" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="LIBRARY" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedForeground}"
                               Margin="0,0,0,8" />
                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource KeyCapBorder}" BorderThickness="1"
                            CornerRadius="4" Padding="6,4">
                        <TextBox Style="{StaticResource HintTextBox}" Tag="Search title, artist or key"
                                 Text="{Binding Library.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                </StackPanel>
                <Grid>
                    <TextBlock Text="No songs in the library yet." TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}"
                               Margin="4,8" Visibility="{Binding Library.IsEmpty, Converter={StaticResource BoolToVisible}}" />
                    <ListBox x:Name="LibraryList" ItemsSource="{Binding Library.Songs}" ItemContainerStyle="{StaticResource LibrarySongItem}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="LibraryList_PreviewMouseLeftButtonDown" MouseMove="LibraryList_MouseMove"
                             MouseDoubleClick="LibraryList_MouseDoubleClick" KeyDown="LibraryList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel ToolTip="Drag into the setlist, or double-click to add it at the end">
                                    <Button DockPanel.Dock="Right" Content="&#xE710;" Style="{StaticResource FlatButton}" Padding="7,5"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"
                                            Foreground="{DynamicResource MutedForeground}"
                                            ToolTip="Add to the setlist" AutomationProperties.Name="Add to the setlist"
                                            Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisible}}"
                                            Command="{Binding DataContext.AddSongCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LibrarySong}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
