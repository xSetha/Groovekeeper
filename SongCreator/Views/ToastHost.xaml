<UserControl x:Class="SongCreator.Views.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:SongCreator.Services">
    <!-- The toasts, newest at the bottom. No background, so clicks pass through where there is no toast. -->
    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="Card" Width="340" Margin="0,8,0,0" CornerRadius="4" BorderThickness="1"
                        Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource PopupBorder}"
                        Effect="{DynamicResource CardShadow}" Loaded="Toast_Loaded"
                        MouseEnter="Toast_MouseEnter" MouseLeave="Toast_MouseLeave">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <!-- Slides up and fades in -->
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                     From="12" To="0" Duration="0:0:0.15" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Bar" Width="4" CornerRadius="4,0,0,4" Background="{DynamicResource InfoBrush}" />
                        <TextBlock x:Name="Icon" Grid.Column="1" Text="&#xE946;" Margin="12,13,0,0" VerticalAlignment="Top"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{DynamicResource InfoBrush}" />
                        <StackPanel Grid.Column="2" Margin="10,11,4,12">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextForeground}" />
                            <TextBlock Text="{Binding Message}" Margin="0,3,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForeground}"
                                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisible}}" />
                        </StackPanel>
                        <Button Grid.Column="3" Content="&#xE711;" Style="{StaticResource FlatButton}" Padding="6"
                                Margin="0,6,6,0" VerticalAlignment="Top" ToolTip="Close"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                Foreground="{DynamicResource MutedForeground}" Command="{Binding CloseCommand}" />
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:NotificationKind.Success}">
                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource SuccessBrush}" />
                        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                        <Setter TargetName="Icon" Property="Text" Value="&#xE73E;" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:NotificationKind.Warning}">
                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource WarningBrush}" />
                        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                        <Setter TargetName="Icon" Property="Text" Value="&#xE7BA;" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:NotificationKind.Error}">
                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ErrorBrush}" />
                        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                        <Setter TargetName="Icon" Property="Text" Value="&#xEA39;" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
