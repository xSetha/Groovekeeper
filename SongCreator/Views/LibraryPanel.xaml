<UserControl x:Class="SongCreator.Views.LibraryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The song library (LibraryViewModel): search, then the songs. Double-click or Enter opens one. -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <DockPanel Margin="0,0,0,8">
                <!-- Only where the host sets HideCommand (the editor's side panel, not the start page) -->
                <Button x:Name="HideButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="6,2" Visibility="Collapsed"
                        ToolTip="Hide library (Ctrl+B)" AutomationProperties.Name="Hide library"
                        Command="{Binding HideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                </Button>
                <TextBlock Text="LIBRARY" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedForeground}"
                           VerticalAlignment="Center" Visibility="{Binding HasSwitcher, Converter={StaticResource BoolToCollapsed}}" />
                <!-- The open library's name; a click lists the libraries (built in code, as it mixes a list and fixed items) -->
                <Button x:Name="SwitcherButton" Style="{StaticResource FlatButton}" Padding="6,3" HorizontalAlignment="Left"
                        Visibility="{Binding HasSwitcher, Converter={StaticResource BoolToVisible}}"
                        ToolTip="Switch library" AutomationProperties.Name="Switch library" Click="Switcher_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CurrentName}" FontSize="13" FontWeight="SemiBold" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Margin="6,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource KeyCapBorder}" BorderThickness="1"
                    CornerRadius="4" Padding="6,4">
                <TextBox Style="{StaticResource HintTextBox}" Tag="Search title, artist or key"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="+ Import songs…" Style="{StaticResource FlatButton}" Padding="10,6" Command="{Binding ImportCommand}"
                    ToolTip="Add copies of .txt or ChordPro files to the library" />
            <Button Content="+ From the web…" Style="{StaticResource FlatButton}" Padding="10,6" Margin="4,0,0,0"
                    Command="{Binding ImportFromWebCommand}" ToolTip="Find a song's chords online and import them (Ctrl+I)" />
        </StackPanel>

        <Grid>
            <TextBlock Text="No songs yet. Import .txt or ChordPro files, or save a new song (Ctrl+S)." TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedForeground}" Margin="4,8"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />
            <ListBox x:Name="SongList" ItemsSource="{Binding Songs}" ItemTemplate="{StaticResource LibrarySong}"
                     ItemContainerStyle="{StaticResource LibrarySongItem}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="SongList_MouseDoubleClick" KeyDown="SongList_KeyDown">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Command="{Binding OpenCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Delete from library…" Command="{Binding DeleteCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
