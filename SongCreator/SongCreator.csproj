<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\SongCreator.ico</ApplicationIcon>
    <!-- The app's name, shown in Task Manager and the file's properties. The code keeps its old name, SongCreator. -->
    <Product>Groovekeeper</Product>
    <AssemblyTitle>Groovekeeper</AssemblyTitle>
    <!-- The release version; see docs/RELEASING.md before changing it -->
    <Version>1.1.0</Version>
    <!-- App.Main runs Velopack before WPF starts -->
    <StartupObject>SongCreator.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SongCreator.ico" />
    <Resource Include="Assets\Backgrounds\*.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
