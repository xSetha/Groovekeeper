<!-- Paper: a warm light theme, like a printed songbook, with a coral accent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:Boolean x:Key="IsDarkTheme">False</sys:Boolean>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SongFont">Cascadia Mono, Consolas</FontFamily>

    <SolidColorBrush x:Key="WindowBackground" Color="#F7F5F0" />
    <SolidColorBrush x:Key="ToolbarBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TabStripBackground" Color="#EDE9E1" />
    <SolidColorBrush x:Key="TabHoverBackground" Color="#E5E0D6" />
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#E6E1D6" />
    <SolidColorBrush x:Key="PopupBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBorder" Color="#E0DACE" />

    <SolidColorBrush x:Key="TextForeground" Color="#1F2328" />
    <SolidColorBrush x:Key="MutedForeground" Color="#6B6F76" />
    <SolidColorBrush x:Key="HintForeground" Color="#B3AFA6" />
    <SolidColorBrush x:Key="DisabledForeground" Color="#B3AFA6" />

    <SolidColorBrush x:Key="ChordTagBackground" Color="#FFE3D5" />
    <SolidColorBrush x:Key="ChordTagForeground" Color="#B23A0E" />
    <SolidColorBrush x:Key="ChordEditorBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ColumnHighlight" Color="#26E4572E" />

    <SolidColorBrush x:Key="ButtonHover" Color="#ECE7DD" />
    <SolidColorBrush x:Key="AccentBrush" Color="#D9481F" />
    <SolidColorBrush x:Key="AccentFill" Color="#E4572E" />
    <SolidColorBrush x:Key="OnAccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FocusBorder" Color="#E4572E" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#F4A98C" />
    <SolidColorBrush x:Key="KeyCapBorder" Color="#D6D0C3" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#D6D0C3" />

    <DropShadowEffect x:Key="CardShadow" BlurRadius="32" ShadowDepth="6" Opacity="0.14" Color="#6B5A3E" />
</ResourceDictionary>
