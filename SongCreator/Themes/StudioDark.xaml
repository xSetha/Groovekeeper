<!-- Studio: the original neutral dark theme with an amber accent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
    <FontFamily x:Key="SongFont">Consolas</FontFamily>

    <SolidColorBrush x:Key="WindowBackground" Color="#1B1B1B" />
    <SolidColorBrush x:Key="ToolbarBackground" Color="#242424" />
    <SolidColorBrush x:Key="TabStripBackground" Color="#161616" />
    <SolidColorBrush x:Key="TabHoverBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="CardBackground" Color="#232323" />
    <SolidColorBrush x:Key="CardBorder" Color="#2F2F2F" />
    <SolidColorBrush x:Key="PopupBackground" Color="#2A2A2A" />
    <SolidColorBrush x:Key="PopupBorder" Color="#3A3A3A" />

    <SolidColorBrush x:Key="TextForeground" Color="#E6E6E6" />
    <SolidColorBrush x:Key="MutedForeground" Color="#8A8A8A" />
    <SolidColorBrush x:Key="HintForeground" Color="#555555" />
    <SolidColorBrush x:Key="DisabledForeground" Color="#5A5A5A" />

    <SolidColorBrush x:Key="ChordTagBackground" Color="#363636" />
    <SolidColorBrush x:Key="ChordTagForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChordEditorBackground" Color="#444444" />
    <SolidColorBrush x:Key="ColumnHighlight" Color="#30FFFFFF" />

    <SolidColorBrush x:Key="ButtonHover" Color="#3A3A3A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E8A33D" />
    <SolidColorBrush x:Key="AccentFill" Color="#E8A33D" />
    <SolidColorBrush x:Key="OnAccentForeground" Color="#1B1B1B" />
    <SolidColorBrush x:Key="FocusBorder" Color="#5A8FD8" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#5A8FD8" />
    <SolidColorBrush x:Key="KeyCapBorder" Color="#4A4A4A" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#3F3F3F" />

    <DropShadowEffect x:Key="CardShadow" BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="Black" />
</ResourceDictionary>
