<!-- Amp: near-black with blood red, like a guitar amp on a dark stage. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SongFont">Cascadia Mono, Consolas</FontFamily>

    <SolidColorBrush x:Key="WindowBackground" Color="#0F0D0D" />
    <SolidColorBrush x:Key="ToolbarBackground" Color="#161313" />
    <SolidColorBrush x:Key="TabStripBackground" Color="#0A0909" />
    <SolidColorBrush x:Key="TabHoverBackground" Color="#1A1616" />
    <SolidColorBrush x:Key="CardBackground" Color="#191515" />
    <SolidColorBrush x:Key="CardBorder" Color="#2A2222" />
    <SolidColorBrush x:Key="PopupBackground" Color="#1D1818" />
    <SolidColorBrush x:Key="PopupBorder" Color="#352B2B" />

    <SolidColorBrush x:Key="TextForeground" Color="#ECE6E1" />
    <SolidColorBrush x:Key="MutedForeground" Color="#9A8F8A" />
    <SolidColorBrush x:Key="HintForeground" Color="#5E5450" />
    <SolidColorBrush x:Key="DisabledForeground" Color="#5E5450" />

    <SolidColorBrush x:Key="ChordTagBackground" Color="#241B1B" />
    <SolidColorBrush x:Key="ChordTagForeground" Color="#E5534A" />
    <SolidColorBrush x:Key="ColumnHighlight" Color="#40E5534A" />

    <SolidColorBrush x:Key="ButtonHover" Color="#221C1C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E5534A" />
    <SolidColorBrush x:Key="AccentFill" Color="#8E0E12" />
    <!-- Text that isn't valid, e.g. a typed chord name that isn't a chord -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFB347" />
    <SolidColorBrush x:Key="OnAccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#B3262C" />
    <SolidColorBrush x:Key="KeyCapBorder" Color="#3A3030" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#332929" />

    <!-- The app's logo (StartPage), drawn in this theme's colors -->
    <SolidColorBrush x:Key="LogoTile" Color="#141111" />
    <SolidColorBrush x:Key="LogoRecord" Color="#050404" />
    <SolidColorBrush x:Key="LogoRing" Color="#E5534A" />
    <SolidColorBrush x:Key="LogoLabel" Color="#C4161C" />

    <!-- The start page's photo, dimmed under WindowBackground so the text stays readable -->
    <BitmapImage x:Key="StartBackground" UriSource="/Assets/Backgrounds/amp.jpg" />
    <sys:Double x:Key="StartBackgroundDim">0.84</sys:Double>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
</ResourceDictionary>
