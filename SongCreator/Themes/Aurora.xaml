<!-- Aurora: deep ink-blue surfaces, a violet glow and a violet→cyan gradient accent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>
    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="SongFont">Cascadia Mono, Consolas</FontFamily>

    <RadialGradientBrush x:Key="WindowBackground" GradientOrigin="0.05,0" Center="0.05,0" RadiusX="1.1" RadiusY="0.9">
        <GradientStop Color="#1C1636" Offset="0" />
        <GradientStop Color="#0E1016" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="ToolbarBackground" Color="#12141D" />
    <SolidColorBrush x:Key="TabStripBackground" Color="#0B0D12" />
    <SolidColorBrush x:Key="TabHoverBackground" Color="#171B27" />
    <SolidColorBrush x:Key="CardBackground" Color="#151925" />
    <SolidColorBrush x:Key="CardBorder" Color="#262D42" />
    <SolidColorBrush x:Key="PopupBackground" Color="#1A1F2E" />
    <SolidColorBrush x:Key="PopupBorder" Color="#2E3650" />

    <SolidColorBrush x:Key="TextForeground" Color="#E8EAF2" />
    <SolidColorBrush x:Key="MutedForeground" Color="#8A91A8" />
    <SolidColorBrush x:Key="HintForeground" Color="#4A5068" />
    <SolidColorBrush x:Key="DisabledForeground" Color="#4A5068" />

    <LinearGradientBrush x:Key="ChordTagBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3D2C75" Offset="0" />
        <GradientStop Color="#1C3B5E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ChordTagForeground" Color="#E4DAFF" />
    <SolidColorBrush x:Key="ColumnHighlight" Color="#408B5CF6" />

    <SolidColorBrush x:Key="ButtonHover" Color="#222840" />
    <SolidColorBrush x:Key="AccentBrush" Color="#A78BFA" />
    <LinearGradientBrush x:Key="AccentFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8B5CF6" Offset="0" />
        <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OnAccentForeground" Color="#0B0D12" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#7C5CE0" />
    <SolidColorBrush x:Key="KeyCapBorder" Color="#2E3550" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#2E3650" />

    <!-- A soft violet glow instead of a drop shadow -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="48" ShadowDepth="0" Opacity="0.35" Color="#8B5CF6" />
</ResourceDictionary>
