<Window x:Class="SongCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SongCreator.Controls"
        xmlns:views="clr-namespace:SongCreator.Views"
        xmlns:music="clr-namespace:SongCreator.Music"
        x:Name="Root"
        Title="{Binding WindowTitle}" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen"
        Icon="Assets/SongCreator.ico"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextForeground}"
        FontFamily="{DynamicResource UiFont}"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewSongCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenSongCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportPdfCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ShowSetlistsCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleLibraryPanelCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ImportFromWebCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
    </Window.InputBindings>

    <Grid>
    <DockPanel>
        <!-- Menu bar, with the theme button on the right -->
        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackground}">
            <ToggleButton x:Name="ThemeButton" DockPanel.Dock="Right" Style="{StaticResource IconToggle}"
                          Content="&#xE790;" ToolTip="Theme" Margin="0,0,8,0"
                          IsHitTestVisible="{Binding IsOpen, ElementName=ThemePopup, Converter={StaticResource InverseBoolean}}" />
            <Popup x:Name="ThemePopup" PlacementTarget="{Binding ElementName=ThemeButton}" Placement="Custom"
                   IsOpen="{Binding IsChecked, ElementName=ThemeButton, Mode=TwoWay}" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource PopupBorder}"
                        BorderThickness="1" CornerRadius="4" Padding="6" Margin="16" Width="310"
                        Effect="{DynamicResource CardShadow}">
                    <StackPanel>
                        <TextBlock Text="THEME" FontSize="11" FontWeight="SemiBold" Margin="10,6,10,6"
                                   Foreground="{DynamicResource MutedForeground}" />
                        <ItemsControl ItemsSource="{Binding Themes.Options}" ItemTemplate="{StaticResource ThemeOptionTemplate}" />
                    </StackPanel>
                </Border>
            </Popup>

            <Menu DockPanel.Dock="Left">
                <MenuItem Header="_File">
                    <MenuItem Header="_New Song" InputGestureText="Ctrl+N" Command="{Binding NewSongCommand}" />
                    <MenuItem Header="_Open Song…" InputGestureText="Ctrl+O" Command="{Binding OpenSongCommand}" />
                    <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"
                              IsEnabled="{Binding IsEditingSong}" />
                    <MenuItem Header="Save _As File…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"
                              IsEnabled="{Binding IsEditingSong}" />
                    <Separator />
                    <MenuItem Header="_Import Songs into Library…" Command="{Binding Library.ImportCommand}" />
                    <MenuItem Header="Import from _Web…" InputGestureText="Ctrl+I" Command="{Binding ImportFromWebCommand}" />
                    <MenuItem Header="_Back Up Library…" Command="{Binding BackupLibraryCommand}" />
                    <Separator />
                    <MenuItem Header="_Export PDF…" InputGestureText="Ctrl+E" Command="{Binding ExportPdfCommand}" />
                    <Separator />
                    <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click" />
                </MenuItem>
                <MenuItem Header="_Settings" ToolTip="Settings (Ctrl+,)" Command="{Binding OpenSettingsCommand}" />
            </Menu>

            <!-- Songs or Setlists (Ctrl+L) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton Content="Songs" Style="{StaticResource ViewTab}"
                             IsChecked="{Binding IsSetlistsViewActive, Converter={StaticResource InverseBoolean}}" />
                <RadioButton Content="Setlists" Style="{StaticResource ViewTab}" ToolTip="Setlists (Ctrl+L)"
                             IsChecked="{Binding IsSetlistsViewActive}" />
            </StackPanel>
        </DockPanel>

        <!-- The Setlists tab and the Songs tab share the space below the menu bar -->
        <Grid>
            <!-- The Setlists tab -->
            <views:SetlistsView DataContext="{Binding Setlists}"
                                Visibility="{Binding DataContext.IsSetlistsViewActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisible}}" />

            <!-- The Songs tab -->
            <Grid Visibility="{Binding IsSetlistsViewActive, Converter={StaticResource BoolToCollapsed}}">
                <!-- Shown while no song is open -->
                <views:StartPage Visibility="{Binding HasDocuments, Converter={StaticResource BoolToCollapsed}}" />

                <DockPanel Visibility="{Binding HasDocuments, Converter={StaticResource BoolToVisible}}">
                    <!-- The library, next to the open songs (Ctrl+B). It slides shut; a thin rail brings it back. -->
                    <Grid x:Name="LibraryHost" DockPanel.Dock="Left" Width="260" ClipToBounds="True">
                        <Border Width="260" HorizontalAlignment="Left" Background="{DynamicResource ToolbarBackground}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0" Padding="12">
                            <views:LibraryPanel DataContext="{Binding Library}"
                                                HideCommand="{Binding DataContext.ToggleLibraryPanelCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Border>
                    </Grid>
                    <Border DockPanel.Dock="Left" Width="28" Background="{DynamicResource ToolbarBackground}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0"
                            Visibility="{Binding IsLibraryPanelOpen, Converter={StaticResource BoolToCollapsed}}">
                        <Button Style="{StaticResource FlatButton}" VerticalAlignment="Top" Padding="4,8" Margin="0,4,0,0"
                                ToolTip="Show library (Ctrl+B)" AutomationProperties.Name="Show library"
                                Command="{Binding ToggleLibraryPanelCommand}">
                            <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                    </Border>

                    <!-- One tab per open song -->
                    <ListBox x:Name="TabStrip" DockPanel.Dock="Top" Background="{DynamicResource TabStripBackground}"
                             BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource SongTab}"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument}"
                             SelectionChanged="TabStrip_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding HomeDescription}">
                                    <TextBlock Style="{StaticResource SongHomeIcon}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Song.DisplayTitle}" MaxWidth="200" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Button Content="✕" Style="{StaticResource FlatButton}" Padding="6,2" Margin="10,0,0,0"
                                            FontSize="10" Foreground="{DynamicResource MutedForeground}" ToolTip="Close song"
                                            Command="{Binding DataContext.CloseSongCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Editor for the active song -->
                    <DockPanel x:Name="EditorPanel" DataContext="{Binding ActiveDocument}">
                        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackground}" Padding="8,6">
                            <DockPanel>
                                <!-- Where the song is saved, and Save (same as Ctrl+S) -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding HomeDescription}" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource SongHomeIcon}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding HomeLabel}" VerticalAlignment="Center" MaxWidth="220"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedForeground}" />
                                    </StackPanel>
                                    <Button Style="{StaticResource FlatButton}" ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save"
                                            Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="Save" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource FlatButton}" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"
                                            Click="Undo_Click">
                                        <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource FlatButton}" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"
                                            Click="Redo_Click">
                                        <TextBlock Text="&#xE7A6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource FlatButton}" ToolTip="Find and replace (Ctrl+F)" AutomationProperties.Name="Find and replace"
                                            Click="Find_Click">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                                    </Button>
                                    <Button Content="+ Section" Style="{StaticResource FlatButton}" Margin="12,0,0,0" Command="{Binding AddSectionCommand}" />
                                    <TextBlock Text="Transpose" Margin="24,0,6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedForeground}" />
                                    <Button Content="−" Style="{StaticResource FlatButton}" Command="{Binding TransposeDownCommand}" ToolTip="Down one semitone" />
                                    <Button Content="+" Style="{StaticResource FlatButton}" Command="{Binding TransposeUpCommand}" ToolTip="Up one semitone" />
                                    <!-- The key the song is in, as the user sets it; transposing moves only the chords -->
                                    <TextBlock Text="Key" Margin="20,0,6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedForeground}" />
                                    <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{x:Static music:MusicKeys.All}"
                                              SelectedItem="{Binding KeyChoice}" FontWeight="SemiBold" MinHeight="26"
                                              MaxDropDownHeight="540" ToolTip="Key">
                                        <!-- The values stay letters; Do Re Mi only changes what's shown -->
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource NoteName}">
                                                            <Binding />
                                                            <Binding Path="DataContext.Settings.Naming" ElementName="Root" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <ComboBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ComboBox.ItemsPanel>
                                    </ComboBox>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Find and replace, opened with Ctrl+F -->
                        <Border x:Name="FindBar" DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackground}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="8,6"
                                Visibility="{Binding Find.IsOpen, Converter={StaticResource BoolToVisible}}">
                            <Border.InputBindings>
                                <KeyBinding Key="Escape" Command="{Binding Find.CloseCommand}" />
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource KeyCapBorder}" BorderThickness="1"
                                        CornerRadius="4" Padding="6,3" Width="180">
                                    <TextBox x:Name="FindBox" Style="{StaticResource HintTextBox}" Tag="Find" IsUndoEnabled="True"
                                             Text="{Binding Find.FindText, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding Find.FindNextCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Border>
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource KeyCapBorder}" BorderThickness="1"
                                        CornerRadius="4" Padding="6,3" Width="180" Margin="6,0,0,0">
                                    <TextBox Style="{StaticResource HintTextBox}" Tag="Replace with" IsUndoEnabled="True"
                                             Text="{Binding Find.ReplaceText, UpdateSourceTrigger=PropertyChanged}" />
                                </Border>
                                <ToggleButton Style="{StaticResource IconToggle}" Width="64" Margin="6,0,0,0"
                                              FontFamily="{DynamicResource UiFont}" FontSize="12" Content="Chords"
                                              ToolTip="Search chord names instead of lyrics" IsChecked="{Binding Find.SearchChords}" />
                                <Button Content="Next" Style="{StaticResource FlatButton}" Margin="6,0,0,0" ToolTip="Find next (Enter)"
                                        Command="{Binding Find.FindNextCommand}"
                                        Visibility="{Binding Find.SearchChords, Converter={StaticResource BoolToCollapsed}}" />
                                <Button Content="Replace all" Style="{StaticResource FlatButton}" Command="{Binding Find.ReplaceAllCommand}" />
                                <TextBlock Text="{Binding Find.Summary}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedForeground}" />
                                <Button Content="✕" Style="{StaticResource FlatButton}" Padding="6,2" Margin="10,0,0,0" FontSize="10"
                                        Foreground="{DynamicResource MutedForeground}" ToolTip="Close (Esc)" Command="{Binding Find.CloseCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- Scrolls sideways too, so a line wider than the editor (or a chord far to the right) is never hidden -->
                        <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      PreviewMouseLeftButtonDown="EditorScroll_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="EditorScroll_PreviewMouseMove"
                                      PreviewMouseLeftButtonUp="EditorScroll_PreviewMouseLeftButtonUp"
                                      GotKeyboardFocus="EditorScroll_GotKeyboardFocus"
                                      PreviewMouseRightButtonDown="EditorScroll_PreviewMouseRightButtonDown">
                            <StackPanel Margin="40,24,40,40">
                                <!-- Text size (Settings): everything in the song scales together -->
                                <StackPanel.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding DataContext.Settings.TextScale, ElementName=Root}"
                                                    ScaleY="{Binding DataContext.Settings.TextScale, ElementName=Root}" />
                                </StackPanel.LayoutTransform>
                                <TextBox x:Name="TitleBox" Text="{Binding Song.Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HintTextBox}" Tag="Song title"
                                         FontSize="26" FontWeight="SemiBold" />
                                <TextBox Text="{Binding Song.Artist, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HintTextBox}" Tag="Artist"
                                         FontSize="16" Foreground="{DynamicResource MutedForeground}" Margin="0,2,0,6" />

                                <!-- The sections, the line showing where a section dragged by its grip will land, the edge of
                                     the printed page, and the notes floating over it all -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Add note here" Click="AddNoteHere_Click" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <ItemsControl x:Name="SectionList" ItemsSource="{Binding Song.Sections}" AllowDrop="True"
                                                  PreviewDragOver="SectionList_PreviewDragOver" PreviewDrop="SectionList_PreviewDrop">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,16,0,0">
                                                    <!-- The heading, marked when a selection across lines would delete it -->
                                                    <Grid HorizontalAlignment="Left">
                                                        <Rectangle x:Name="HeadingSelection" Fill="{DynamicResource SelectionBrush}" Opacity="0.4"
                                                                   Visibility="Collapsed" IsHitTestVisible="False" />
                                                        <StackPanel Orientation="Horizontal" TextElement.FontFamily="{DynamicResource SongFont}"
                                                                    TextElement.FontSize="16">
                                                            <!-- Grip to drag the section; out in the margin, so headings stay in line with the lyrics -->
                                                            <TextBlock Text="&#xE76F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                                                       Width="20" Margin="-24,0,4,0" VerticalAlignment="Center" TextAlignment="Center"
                                                                       Background="Transparent" Cursor="SizeAll" ToolTip="Drag to move the section"
                                                                       Foreground="{DynamicResource MutedForeground}"
                                                                       MouseLeftButtonDown="SectionGrip_MouseLeftButtonDown"
                                                                       MouseMove="SectionGrip_MouseMove" MouseLeftButtonUp="SectionGrip_MouseLeftButtonUp" />
                                                            <TextBlock Text="[" />
                                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource BareTextBox}"
                                                                     FontFamily="{DynamicResource SongFont}" FontSize="16" MinWidth="20" Margin="-2,0" />
                                                            <TextBlock Text="]" />
                                                            <TextBlock Text="(repeat)" Margin="8,0,0,0" FontStyle="Italic"
                                                                       FontFamily="{DynamicResource UiFont}" FontSize="13" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource MutedForeground}"
                                                                       Visibility="{Binding IsRepeat, Converter={StaticResource BoolToVisible}}" />
                                                            <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                                                                        TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                        TextElement.FontSize="11">
                                                                <Button Content="&#xE70E;" Style="{StaticResource FlatButton}" Padding="6,2"
                                                                        Foreground="{DynamicResource MutedForeground}" ToolTip="Move up"
                                                                        Command="{Binding DataContext.MoveSectionUpCommand, ElementName=EditorPanel}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="&#xE70D;" Style="{StaticResource FlatButton}" Padding="6,2"
                                                                        Foreground="{DynamicResource MutedForeground}" ToolTip="Move down"
                                                                        Command="{Binding DataContext.MoveSectionDownCommand, ElementName=EditorPanel}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="&#xE8C8;" Style="{StaticResource FlatButton}" Padding="6,2"
                                                                        Foreground="{DynamicResource MutedForeground}" ToolTip="Duplicate section"
                                                                        Command="{Binding DataContext.DuplicateSectionCommand, ElementName=EditorPanel}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="&#xE8EE;" Style="{StaticResource FlatButton}" Padding="6,2"
                                                                        Foreground="{DynamicResource MutedForeground}" ToolTip="Repeat at the end of the song"
                                                                        Command="{Binding DataContext.RepeatSectionCommand, ElementName=EditorPanel}"
                                                                        CommandParameter="{Binding}"
                                                                        Visibility="{Binding IsRepeat, Converter={StaticResource BoolToCollapsed}}" />
                                                            </StackPanel>
                                                            <Button Content="✕" Style="{StaticResource FlatButton}" Padding="6,0" Margin="12,0,0,0"
                                                                    FontSize="11" Foreground="{DynamicResource MutedForeground}" ToolTip="Delete section"
                                                                    Command="{Binding DataContext.DeleteSectionCommand, ElementName=EditorPanel}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <!-- A repeat has no lines of its own -->
                                                    <ItemsControl ItemsSource="{Binding Lines}"
                                                                  Visibility="{Binding IsRepeat, Converter={StaticResource BoolToCollapsed}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <controls:SongLineControl SongKey="{Binding DataContext.SongKey, ElementName=EditorPanel}"
                                                                                          ChordStyle="{Binding DataContext.Settings.ChordStyle, ElementName=Root}"
                                                                                          HighlightText="{Binding DataContext.Find.HighlightText, ElementName=EditorPanel}"
                                                                                          CurrentMatch="{Binding DataContext.Find.CurrentMatch, ElementName=EditorPanel}"
                                                                                          SplitRequested="Line_SplitRequested"
                                                                                          MergeRequested="Line_MergeRequested"
                                                                                          MoveFocusRequested="Line_MoveFocusRequested"
                                                                                          PasteLinesRequested="Line_PasteLinesRequested"
                                                                                      AddNoteRequested="AddNoteHere_Click" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Content="+ Line" Style="{StaticResource FlatButton}" HorizontalAlignment="Left"
                                                            Padding="6,1" Margin="0,4,0,0" FontSize="12"
                                                            Foreground="{DynamicResource MutedForeground}"
                                                            Command="{Binding DataContext.AddLineCommand, ElementName=EditorPanel}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsRepeat, Converter={StaticResource BoolToCollapsed}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Rectangle x:Name="SectionDropLine" Height="2" VerticalAlignment="Top" Fill="{DynamicResource AccentBrush}"
                                               Visibility="Collapsed" IsHitTestVisible="False" />
                                    <!-- Past this line, notes and lyrics run off the printed page -->
                                    <Rectangle x:Name="PageEdge" Width="1" HorizontalAlignment="Left" Fill="{DynamicResource HintForeground}"
                                               Opacity="0.6" IsHitTestVisible="False" />
                                    <Canvas x:Name="NoteLayer" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>

    <!-- Toasts, over everything in the bottom-right corner -->
    <views:ToastHost x:Name="ToastArea" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" />
    </Grid>
</Window>
