# The account database the app syncs with. These are the local Supabase's (`npm run db:start` in web/): the
# same for every local install and not secret. A deployed app gets its own from the hosting settings.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Cloudflare Turnstile, the check against bots on the sign-in forms. This is Cloudflare's test key, which always
# passes and goes with the test secret in supabase/config.toml. A deployed app gets its own site's key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Who runs this copy of the app and how to reach them, for the privacy page. A deployed app sets its own.
VITE_SITE_OPERATOR=the person running this copy
VITE_CONTACT_EMAIL=privacy@example.com
